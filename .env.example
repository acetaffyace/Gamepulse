# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会入库。
# 采集器启动时读取本文件，只补充进程中尚未设置的变量；
# Windows 计划任务不继承终端里的临时变量，因此代理和密钥应写在这里。

# YouTube Data API v3 密钥（免费层即可）
YOUTUBE_API_KEY=

# 境内访问 Steam / YouTube 需要的代理；B 站请求始终直连，不受此项影响
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# 设为 1 后，每日计划任务在构建完成后把 dist/ 推送到 gh-pages 分支（GitHub Pages）。
# 默认不推送；也可以随时手动运行 python tools/publish_pages.py --push
GAMEPULSE_AUTO_PUBLISH=0
