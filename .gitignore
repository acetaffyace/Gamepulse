# 采集产生的大体积原始响应：评测回填单文件可达 10MB+，
# 且可由 steam_reviews_backfill.py 随时重建，不进版本库。
data/raw/backfill/
data/raw/20*/

# 时间序列与快照是项目的真实产出，必须入库，打开页面即可查看真实采集数据。
# 不要在这里忽略 data/series/ 或 data/snapshot_*.json。

# 计划任务日志：机器本地产物，不入版本库
data/logs/
dashboard/shots/_*.png
node_modules/

# Cross-process locks and recovery backups
*.lock
*.bak
data/index.previous.json

# 本地工作笔记与历史审查记录，不入库
notes/

# 采集流水日志：每小时追加，机器本地产物
data/collect-log.tsv

# spike 产物
spike/out/
spike/node_modules/

# v3 本机数据库与每日备份：不进版本库
data/gamepulse.sqlite
data/gamepulse.sqlite-*
data/backups/

# v3 发布包（由 python -m store.build 生成）
dist/
