{
  "palette": {
    "slot1": "#2a78d6",
    "slot2": "#eb6834",
    "slot3": "#1baf7a",
    "slot5": "#e87ba4",
    "slot7": "#4a3aa7",
    "neutral": "#898781"
  },
  "share_ramp": [
    "#16365f",
    "#1d4c86",
    "#2a78d6",
    "#4d97e2",
    "#7ab5ea",
    "#a3cdf2",
    "#c6e0f8",
    "#e0edfb"
  ],
  "share_other": "#c3c2b7",
  "lanes": [
    {
      "id": "new_reviews",
      "title": "每日新增评测",
      "subtitle": "回填重建 · 讨论热度代理",
      "adapter": "series",
      "path": "review_history",
      "field": "new_reviews",
      "chart": "bar",
      "color": "slot1",
      "height": 140,
      "unit": "count",
      "enabled": true,
      "caveat": "仅含今天仍存在的评测，越早的日期越可能低估"
    },
    {
      "id": "review_rate",
      "title": "好评率",
      "subtitle": "当日 / 累计",
      "adapter": "series",
      "path": "review_history",
      "chart": "line",
      "height": 110,
      "unit": "percent",
      "enabled": true,
      "compare_field": "cumulative_review_rate",
      "series": [
        {
          "field": "daily_review_rate",
          "name": "当日好评率",
          "color": "slot2",
          "width": 1.5,
          "opacity": 0.75
        },
        {
          "field": "cumulative_review_rate",
          "name": "累计好评率",
          "color": "slot3",
          "width": 2.5,
          "smooth": true,
          "end_label": true
        }
      ]
    },
    {
      "id": "online",
      "title": "Steam 同时在线人数",
      "subtitle": "逐日采集 · 平台同时在线，非 DAU",
      "adapter": "series",
      "path": "online_series",
      "field": "value",
      "chart": "line",
      "color": "slot7",
      "height": 110,
      "unit": "count",
      "enabled": true,
      "symbol": true,
      "caveat": "历史无法回填（SteamDB 不可程序化访问、SteamCharts 未收录），只能逐日积累"
    },
    {
      "id": "online_band",
      "title": "在线日峰谷",
      "subtitle": "小时级采样 · 峰值与谷值",
      "adapter": "series",
      "path": "online_daily",
      "chart": "line",
      "height": 110,
      "unit": "count",
      "enabled": false,
      "series": [
        {
          "field": "peak",
          "name": "日峰值",
          "color": "slot7",
          "width": 2
        },
        {
          "field": "trough",
          "name": "日谷值",
          "color": "slot7",
          "width": 1,
          "opacity": 0.45,
          "dashed": true
        }
      ],
      "caveat": "采样点少于 6 个的日期标 partial，半天的样本算不出真实日峰值"
    },
    {
      "id": "version_marks",
      "title": "版本节奏",
      "subtitle": "每个对比对象一行 · 取自各自 Steam 官方公告",
      "adapter": "version_marks",
      "path": "events",
      "chart": "marks",
      "height": 74,
      "enabled": false,
      "caveat": "多对象对照时版本线画在本轨道内，不贯穿全图 —— 各自的版本不是同一个事件"
    },
    {
      "id": "playtime_median",
      "title": "评测者中位游戏时长",
      "subtitle": "写评测时已玩多久 · 小时",
      "adapter": "series",
      "path": "review_profile.daily",
      "field": "playtime_at_review_median",
      "chart": "line",
      "color": "slot2",
      "height": 110,
      "unit": "minutes_as_hours",
      "enabled": true,
      "caveat": "评测者不是玩家的随机样本，只代表写评测的人"
    },
    {
      "id": "short_play_share",
      "title": "2 小时内评测占比",
      "subtitle": "Steam 退款时长线以内就来评测的比例",
      "adapter": "series",
      "path": "review_profile.daily",
      "field": "short_play_share",
      "chart": "line",
      "color": "slot1",
      "height": 100,
      "unit": "percent",
      "enabled": false
    },
    {
      "id": "heavy_play_share",
      "title": "100 小时以上评测占比",
      "subtitle": "重度玩家在评测者中的比例",
      "adapter": "series",
      "path": "review_profile.daily",
      "field": "heavy_play_share",
      "chart": "line",
      "color": "slot3",
      "height": 100,
      "unit": "percent",
      "enabled": false
    },
    {
      "id": "language_delta",
      "title": "评测语种结构变化",
      "subtitle": "相对首个 7 天桶的百分点差 · 0 为基线",
      "adapter": "share_delta",
      "path": "review_profile.language_share",
      "chart": "line",
      "height": 130,
      "unit": "pp",
      "top_n": 5,
      "enabled": false,
      "single_only": true,
      "caveat": "只画变化幅度最大的几个语种，尾部语种的占比本来就在噪声量级"
    },
    {
      "id": "language_share",
      "title": "评测语种构成",
      "subtitle": "7 天分桶 · 绝对占比",
      "adapter": "stacked_share",
      "path": "review_profile.language_share",
      "chart": "stacked_area",
      "height": 130,
      "unit": "percent",
      "enabled": false,
      "single_only": true,
      "caveat": "100% 堆叠的中间层没有稳定基线，看结构变化请用「语种结构变化」轨道"
    },
    {
      "id": "bili_videos",
      "title": "B 站官方视频",
      "subtitle": "横轴为发布日 · 纵轴为当前累计播放量",
      "adapter": "video_scatter",
      "path": "bilibili.videos",
      "field": "view",
      "chart": "scatter",
      "color": "slot5",
      "height": 130,
      "unit": "count",
      "enabled": true,
      "caveat": "仅登记视频集合，不是全站播放量，也不是独立观众数"
    },
    {
      "id": "bili_version_pv",
      "title": "B 站版本 PV",
      "subtitle": "只含版本 PV · 发布日 × 当前累计播放",
      "adapter": "video_scatter",
      "path": "bilibili.videos",
      "field": "view",
      "content_types": [
        "version_trailer"
      ],
      "chart": "scatter",
      "color": "slot7",
      "height": 110,
      "unit": "count",
      "enabled": false,
      "caveat": "版本 PV 与角色 PV 的发布节奏和推荐位待遇不同，混在一起比没有意义"
    },
    {
      "id": "bili_character_pv",
      "title": "B 站角色 PV / 演示",
      "subtitle": "只含角色 PV 与战斗演示 · 发布日 × 当前累计播放",
      "adapter": "video_scatter",
      "path": "bilibili.videos",
      "field": "view",
      "content_types": [
        "character_trailer",
        "character_demo",
        "ep"
      ],
      "chart": "scatter",
      "color": "slot5",
      "height": 110,
      "unit": "count",
      "enabled": false,
      "caveat": "角色 PV 通常早于版本更新日 5-12 天发布，位置不等于版本归属"
    },
    {
      "id": "bili_ramp",
      "title": "B 站发布后播放曲线",
      "subtitle": "一支视频一条线 · 横轴为发布后第 N 天",
      "adapter": "video_ramp",
      "path": "bilibili.videos",
      "field": "view",
      "chart": "line",
      "color": "slot5",
      "height": 150,
      "unit": "count",
      "enabled": false,
      "caveat": "接口只返回当前累计值，曲线只能从开始采集那天往后长；虚线表示缺起跑段"
    },
    {
      "id": "bili_version_ramp",
      "title": "B 站版本 PV 播放曲线",
      "subtitle": "只含版本 PV · 横轴为发布后第 N 天",
      "adapter": "video_ramp",
      "path": "bilibili.videos",
      "field": "view",
      "content_types": [
        "version_trailer"
      ],
      "chart": "line",
      "color": "slot7",
      "height": 130,
      "unit": "count",
      "enabled": false,
      "caveat": "同类内容按发布后天数对齐，这是唯一跨视频公平的播放量比较方式"
    },
    {
      "id": "bili_view_delta",
      "title": "B 站日增播放",
      "subtitle": "全部登记视频的播放量日增量合计",
      "adapter": "video_delta",
      "path": "bilibili.videos",
      "field": "view",
      "chart": "bar",
      "color": "slot5",
      "height": 110,
      "enabled": false
    },
    {
      "id": "bili_engagement",
      "title": "B 站互动率",
      "subtitle": "（点赞+投币+收藏）/ 播放 · 按视频发布日定位",
      "adapter": "video_scatter",
      "path": "bilibili.videos",
      "field": "engagement",
      "from_rates": true,
      "chart": "scatter",
      "color": "slot3",
      "height": 110,
      "unit": "percent",
      "enabled": false,
      "caveat": "互动率跨视频可比，播放量不可比 —— 后者受推荐位影响极大"
    },
    {
      "id": "yt_videos",
      "title": "YouTube 官方视频",
      "subtitle": "横轴为发布日 · 纵轴为当前累计观看数",
      "adapter": "video_scatter",
      "path": "youtube.videos",
      "field": "view",
      "chart": "scatter",
      "color": "slot1",
      "height": 120,
      "unit": "count",
      "enabled": false,
      "caveat": "点赞与评论可被创作者隐藏，隐藏时记 null 不记 0"
    }
  ],
  "presets": {
    "default": {
      "label": "默认",
      "lanes": [
        "new_reviews",
        "review_rate",
        "online",
        "bili_videos"
      ]
    },
    "compare": {
      "label": "多对象对照",
      "lanes": [
        "new_reviews",
        "review_rate",
        "version_marks",
        "bili_engagement"
      ]
    },
    "versions": {
      "label": "版本对照",
      "lanes": [
        "new_reviews",
        "review_rate",
        "playtime_median",
        "bili_version_ramp"
      ]
    },
    "player_profile": {
      "label": "玩家结构",
      "lanes": [
        "new_reviews",
        "playtime_median",
        "short_play_share",
        "heavy_play_share",
        "language_delta"
      ]
    },
    "propagation": {
      "label": "传播端",
      "lanes": [
        "bili_version_pv",
        "bili_character_pv",
        "bili_engagement",
        "bili_ramp"
      ]
    },
    "online_focus": {
      "label": "在线盘",
      "lanes": [
        "online",
        "online_band",
        "new_reviews",
        "review_rate"
      ]
    }
  },
  "adapters": [
    "series",
    "share_delta",
    "stacked_share",
    "version_marks",
    "video_delta",
    "video_ramp",
    "video_scatter"
  ]
}